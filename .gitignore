# Rust / build output
/target/
/target-*/
/crates/*/target/
/.cargo/

# Generated experiment outputs and local model stores
/artifacts/
/configs/sandbox/*
!/configs/sandbox/README.md
/.cache/
/models/
/assets/models/
/data/omnisvg/

# Web build output
/www/pkg/
/www/worker_pkg/
/www/models/
/www/artifacts/
/www/dist/
/www/.parcel-cache/
/node_modules/

# Python cache
**/__pycache__/
*.py[cod]

# Profiling, logs, and scratch files
*.profraw
*.profdata
*.trace
*.log
*.tmp

# Model/checkpoint artifacts. Keep conversion scripts and manifests in git, but
# do not check in weights or generated binary model packages.
*.bpk
*.safetensors
*.pt
*.pth
*.onnx
*.npz
*.npy
*.ckpt

# Generated binary deliverables
*.bin
*.wasm
*.pdf
!docs/papers/adaptive/adaptive_npa.pdf
!docs/papers/hypernpa/hyper_npa.pdf

# LaTeX intermediates. Paper source, bibliography, figures, and PDFs remain tracked.
/docs/**/*.aux
/docs/**/*.bbl
/docs/**/*.blg
/docs/**/*.fdb_latexmk
/docs/**/*.fls
/docs/**/*.out
