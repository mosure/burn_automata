# Rust / build output
/target/
/target-*/
/crates/*/target/
/.cargo/

# Generated experiment outputs and local model stores
/artifacts/
/configs/sandbox/
/.cache/
/models/
/assets/models/
/data/omnisvg/

# Web build output
/www/pkg/
/www/dist/
/www/.parcel-cache/
/node_modules/

# Python cache
**/__pycache__/
*.py[cod]

# Profiling, logs, and scratch files
*.profraw
*.profdata
*.trace
*.log
*.tmp

# Model/checkpoint artifacts. Keep conversion scripts and manifests in git, but
# do not check in weights or generated binary model packages.
*.bpk
*.safetensors
*.pt
*.pth
*.onnx
*.npz
*.npy
*.ckpt

# Generated binary deliverables
*.bin
*.wasm
*.pdf

# Top-level LaTeX intermediates. Paper source, bibliography, and figures remain tracked.
/docs/*.aux
/docs/*.bbl
/docs/*.blg
/docs/*.fdb_latexmk
/docs/*.fls
/docs/*.out
